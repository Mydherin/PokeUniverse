# Copy to .env (`make env` does it and fills the generated secrets).
# .env is never committed.

# Public origin of the app, as typed in the browser. Must match the Google redirect URI origin.
PUBLIC_URL=http://localhost:8080
SPA_PORT=8080

# PostgreSQL
POSTGRES_USER=pokeuniverse
POSTGRES_DB=pokeuniverse
POSTGRES_PASSWORD=change-me

# Redis (the default user is mic-core's; mic-battles has its own user, limited to battle:* keys)
REDIS_PASSWORD=change-me
REDIS_MIC_BATTLES_PASSWORD=change-me

# NATS (one password per microservice)
NATS_MIC_CORE_PASSWORD=change-me
NATS_MIC_BATTLES_PASSWORD=change-me

# Google OAuth 2.0 client (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application")
# Authorized redirect URI: ${PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Access token signing key (Ed25519). JWT_PRIVATE_KEY is the base64 of the 32-byte seed.
# Generate with: openssl rand -base64 32
JWT_KEY_ID=dev-1
JWT_PRIVATE_KEY=

# Comma-separated emails that get the admin role (on sign-in, and at startup for existing accounts).
# Removing an email doesn't revoke the role.
ADMIN_EMAILS=mydherin@gmail.com

# Dev only: turns on POST /api/dev/bots, used by infra/bots/bots.ts to fill the world with bot players
# (docs/phases/phase-8-multiplayer-world/milestones/context.md D16). Empty = off. Never set in production.
BOTS_SECRET=
# How many mic-core replicas Compose runs (stateless; zones share events over NATS, phase-8 M4).
MIC_CORE_REPLICAS=1
